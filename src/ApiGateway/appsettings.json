{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/users/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "task-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      },
      "time-entry-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/time-entries/{**catch-all}"
        }
      },
      "project-swagger-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/project/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/project"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://ms-auth-api-drcth2bxagdpchad.centralindia-01.azurewebsites.net/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:59569/"
          }
        }
      },
      "project-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:52751/"
          }
        }
      }
    }
  }
}
