{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=UserDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AuthService": {
    "BaseUrl": "http://localhost:59568/"
  },
  "JwtSettings": {
    "Issuer": "AuthService",
    "Audience": "MicroservicesClients",
    "SecretKey": "REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  }
}
